          text: "    # Steps represent a sequence of tasks that will be executed as part of the job"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    steps:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # Checks-out your repository under $GITHUB_WORKSPACE, so your job can access it"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - uses: actions/checkout@v4"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # Gets the download URL associated with the $DETEKT_RELEASE_TAG"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - name: Get Detekt download URL"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      id: detekt_info"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      env:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      run: |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        gh api graphql --field tagName=$DETEKT_RELEASE_TAG --raw-field query=\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          query getReleaseAssetDownloadUrl($tagName: String!) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            repository(name: \"detekt\", owner: \"detekt\") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              release(tagName: $tagName) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                releaseAssets(name: \"detekt\", first: 1) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  nodes {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    downloadUrl"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                tagCommit {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  oid"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \' 1> gh_response.json"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        DETEKT_RELEASE_SHA=$(jq --raw-output \'.data.repository.release.releaseAssets.tagCommit.oid\' gh_response.json)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if [ $DETEKT_RELEASE_SHA != \"37f0a1d006977512f1f216506cd695039607c3e5\" ]; then"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          echo \"Release tag doesn\'t match expected commit SHA\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          exit 1"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        fi"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        DETEKT_DOWNLOAD_URL=$(jq --raw-output \'.data.repository.release.releaseAssets.nodes[0].downloadUrl\' gh_response.json)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        echo \"download_url=$DETEKT_DOWNLOAD_URL\" >> $GITHUB_OUTPUT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # Sets up the detekt cli"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - name: Setup Detekt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      run: |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        dest=$( mktemp -d )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        curl --request GET \\"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          --url ${{ steps.detekt_info.outputs.download_url }} \\"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          --silent \\"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          --location \\"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          --output $dest/detekt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        chmod a+x $dest/detekt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        echo $dest >> $GITHUB_PATH"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # Performs static analysis using Detekt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - name: Run Detekt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      continue-on-error: true"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      run: |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        detekt --input ${{ github.workspace }} --report sarif:${{ github.workspace }}/detekt.sarif.json"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # Modifies the SARIF output produced by Detekt so that absolute URIs are relative"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # This is so we can easily map results onto their source files"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # This can be removed once relative URI support lands in Detekt: https://git.io/JLBbA"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - name: Make artifact location URIs relative"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      continue-on-error: true"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      run: |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        echo \"$("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          jq \\"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            --arg github_workspace ${{ github.workspace }} \\"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            \'. | ( .runs[].results[].locations[].physicalLocation.artifactLocation.uri |= if test($github_workspace) then .[($github_workspace | length | . + 1):] else . end )\' \\"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            ${{ github.workspace }}/detekt.sarif.json"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        )\" > ${{ github.workspace }}/detekt.sarif.json"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # Uploads results to GitHub repository using the upload-sarif action"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - uses: github/codeql-action/upload-sarif@v3"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      with:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Path to SARIF file relative to the root of the repository"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        sarif_file: ${{ github.workspace }}/detekt.sarif.json"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        checkout_path: ${{ github.workspace }}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
