        instruction: "name: Scan with Detekt\n\non:\n  push:\n    branches: [ \"main\" ]\n  pull_request:\n    branches: [ \"main\" ]\n  schedule:\n    - cron: \'35 19 * * 6\'\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  security-events: write\n\nenv:\n  DETEKT_VERSION: \"1.23.8\"\n\njobs:\n  scan:\n    name: Scan\n    runs-on: ubuntu-latest\n\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Set up JDK 17\n        uses: actions/setup-java@v4\n        with:\n          distribution: temurin\n          java-version: \"17\"\n\n      - name: Download Detekt CLI\n        run: |\n          curl -fsSL \\\n            \"https://github.com/detekt/detekt/releases/download/v${DETEKT_VERSION}/detekt-cli-${DETEKT_VERSION}-all.jar\" \\\n            -o /tmp/detekt-cli.jar\n\n      - name: Run Detekt\n        continue-on-error: true\n        run: |\n          java -jar /tmp/detekt-cli.jar \\\n            --input \"${{ github.workspace }}/app/src/main/java\" \\\n            --excludes \"**/build/**,**/.gradle/**\" \\\n            --report \"sarif:${{ github.workspace }}/detekt.sarif.json\"\n\n      - name: Make artifact location URIs relative\n        if: always()\n        run: |\n          if [ -f \"${{ github.workspace }}/detekt.sarif.json\" ]; then\n            jq \\\n              --arg github_workspace \"${{ github.workspace }}\" \\\n              \'(.runs[].results[].locations[].physicalLocation.artifactLocation.uri |= if test($github_workspace) then .[($github_workspace | length + 1):] else . end)\' \\\n              \"${{ github.workspace }}/detekt.sarif.json\" > \"${{ github.workspace }}/detekt.sarif.tmp\" \\\n            && mv \"${{ github.workspace }}/detekt.sarif.tmp\" \"${{ github.workspace }}/detekt.sarif.json\"\n          fi\n\n      - name: Upload SARIF file\n        if: hashFiles(\'detekt.sarif.json\') != \'\'\n        uses: github/codeql-action/upload-sarif@v3\n        with:\n          sarif_file: ${{ github.workspace }}/detekt.sarif.json\n          checkout_path: ${{ github.workspace }}\n"
        path {
          absolute_uri: "file:///.github/workflows/detekt.yml"
        }
        overwrite: true
      }
    }
