      arguments_json: "{\"CodeContent\":\"<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?>\\n<paths xmlns:android=\\\"http://schemas.android.com/apk/res/android\\\">\\n    <files-path name=\\\"messages\\\" path=\\\"messages/\\\" />\\n    <files-path name=\\\"greetings\\\" path=\\\"greetings/\\\" />\\n</paths>\\n\", \"Description\":\"Add FileProvider paths for sharing recorded voicemail and greeting audio files\", \"Overwrite\":true, \"TargetFile\":\"/app/src/main/res/xml/file_paths.xml\", \"toolAction\":\"Creating file_paths.xml\", \"toolSummary\":\"Create file_paths.xml\"}"
