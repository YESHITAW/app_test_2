      arguments_json: "{\"CodeContent\":\"package com.example.ui.theme\\n\\nimport androidx.compose.ui.graphics.Color\\n\\n// Tactile Studio Palette \342\200\224 Charcoal Slate + Brushed Aluminum + Signal Amber + Phosphor Emerald\\nval SignalAmber = Color(0xFFFF6B2B)\\nval SignalAmberDark = Color(0xFFD94E14)\\nval SignalAmberContainerLight = Color(0xFFFFEDE5)\\nval SignalAmberContainerDark = Color(0xFF4B1E0B)\\n\\nval PhosphorEmerald = Color(0xFF10B981)\\nval PhosphorEmeraldDark = Color(0xFF059669)\\nval PhosphorContainerLight = Color(0xFFD1FAE5)\\nval PhosphorContainerDark = Color(0xFF064E3B)\\n\\nval TapeGold = Color(0xFFF59E0B)\\nval TapeGoldContainerLight = Color(0xFFFEF3C7)\\nval TapeGoldContainerDark = Color(0xFF452B03)\\n\\nval CrimsonAlert = Color(0xFFEF4444)\\nval CrimsonContainerLight = Color(0xFFFEE2E2)\\nval CrimsonContainerDark = Color(0xFF531313)\\n\\n// Dark Surfaces (Console / Studio Dark)\\nval SlateVoid = Color(0xFF0E1014)\\nval SlateSurface = Color(0xFF15181E)\\nval SlateSurfaceElevated = Color(0xFF1E222B)\\nval SlateSurfaceHigh = Color(0xFF272C37)\\nval SlateOutline = Color(0xFF363D4C)\\nval IvoryText = Color(0xFFF4F1EA)\\nval MutedSlateText = Color(0xFFA0A8B8)\\n\\n// Light Surfaces (Warm Paper / Brushed Aluminum)\\nval WarmPaper = Color(0xFFF6F4EF)\\nval BrushedWhite = Color(0xFFFFFFFF)\\nval SoftStone = Color(0xFFECE9E1)\\nval HighStone = Color(0xFFE2DDD3)\\nval StoneOutline = Color(0xFFC8C2B6)\\nval CharcoalText = Color(0xFF16181D)\\nval MutedCharcoalText = Color(0xFF596070)\\n\", \"Description\":\"Define custom Tactile Studio color tokens in Color.kt\", \"Overwrite\":true, \"TargetFile\":\"/app/src/main/java/com/example/ui/theme/Color.kt\", \"toolAction\":\"Writing Color.kt\", \"toolSummary\":\"Create Color.kt\"}"
